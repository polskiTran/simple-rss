# Canonical origin this installation answers on. Required.
PUBLIC_ORIGIN=http://localhost:5173

# One-time secret that lets the first visitor claim the installation.
# SETUP_SECRET=

# Dev only. Some sandboxes resolve every hostname to 198.18.0.1.
# The value true allows the 198.18.0.0/15 benchmarking range and no other reserved range.
# The server ignores this when NODE_ENV=production and logs a warning at startup.
# ALLOW_RESERVED_FETCH_DESTINATIONS=true
