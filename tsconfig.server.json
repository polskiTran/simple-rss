{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "jsx": "preserve",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/server", "src/shared"]
}
