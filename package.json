{
  "name": "simple-rss",
  "version": "0.1.0-rc.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts | pino-pretty --colorize --messageKey message --levelFirst --translateTime SYS:HH:MM:ss.l",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "start:pretty": "node dist/server/main.js | pino-pretty --colorize --messageKey message --levelFirst --translateTime SYS:HH:MM:ss.l",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:browser": "pnpm build:client && playwright test",
    "lint": "biome check --error-on-warnings . && pnpm lint:anti-slop",
    "lint:anti-slop": "node --import=tsx node_modules/oxlint/bin/oxlint --config oxlint.config.mjs .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "cli": "tsx src/server/cli-main.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hono/node-server": "^1.13.8",
    "@node-rs/argon2": "^2.0.2",
    "@streamdown/math": "^1.0.2",
    "better-sqlite3": "^11.8.1",
    "defuddle": "^0.19.3",
    "drizzle-orm": "^0.39.3",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.7.2",
    "html-to-text": "^10.0.0",
    "katex": "^0.16.47",
    "linkedom": "^0.18.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-math": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@fontsource/literata": "^5.1.1",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/hast": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "oxlint": "1.79.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
